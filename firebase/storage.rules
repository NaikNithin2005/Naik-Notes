rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Helper function to verify authenticated owner
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // User notebook attachments (PDFs, audio recordings, covers)
    match /users/{userId}/{allPaths=**} {
      // 100MB limit for PDFs, 50MB for audio, 5MB for images
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) && request.resource.size < 100 * 1024 * 1024;
    }

    match /{allPaths=**} {
      allow read, write: false;
    }
  }
}

