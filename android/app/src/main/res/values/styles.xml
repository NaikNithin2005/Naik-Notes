<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Naik Notes LaunchTheme with #121212 dark branded background -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <!-- Show branded splash screen on the activity. Automatically removed when
             the Flutter engine draws its first frame -->
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Theme applied to the Android Window as soon as the process has started.
         Matches the application dark surface #121212, preventing any white-screen flash -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/splash_color</item>
    </style>
</resources>
